<mxfile host="ba-bpmn"><diagram name="QTPR-06 Cảnh báo tồn kho và hạn sử dụng" id="bpmn"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P" value="PROC-06 Cảnh báo tồn kho và hạn sử dụng" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=none;fontSize=13;fontStyle=1;collapsible=0;container=1;bpmn=pool;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1574" height="460" as="geometry"/></mxCell><mxCell id="CB" value="Cán bộ căng tin" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;fontSize=11;fontStyle=0;collapsible=0;container=1;bpmn=lane;" vertex="1" parent="P"><mxGeometry x="34" y="0" width="1540" height="160" as="geometry"/></mxCell><mxCell id="HT" value="Hệ thống quản lý kho căng tin" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;fontSize=11;fontStyle=0;collapsible=0;container=1;bpmn=lane;" vertex="1" parent="P"><mxGeometry x="34" y="160" width="1540" height="300" as="geometry"/></mxCell><mxCell id="S1" value="Đến giờ quét hằng ngày" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;whiteSpace=wrap;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;fontSize=10;labelWidth=110;outline=standard;symbol=timer;bpmn=start:timer:;" vertex="1" parent="HT"><mxGeometry x="125" y="60" width="40" height="40" as="geometry"/></mxCell><mxCell id="QTPR-06.01" value="&lt;b&gt;PROC-06.01&lt;/b&gt; Quét tồn dưới mức tối thiểu, lô sắp hết hạn, quá hạn, chờ giá&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;theo tồn tối thiểu, số ngày N của kho&lt;/font&gt;" style="shape=mxgraph.bpmn.task;whiteSpace=wrap;html=1;rectStyle=rounded;size=10;fontSize=11;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;taskMarker=businessRule;bpmn=task:businessRule;" vertex="1" parent="HT"><mxGeometry x="485" y="40" width="160" height="80" as="geometry"/></mxCell><mxCell id="G1" value="Có mục cần cảnh báo?"