<mxfile host="ba-bpmn"><diagram name="QTPR-02 Quản lý nhà cung cấp giá nhập và kho" id="bpmn"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P" value="PROC-02 Quản lý nhà cung cấp, giá nhập và kho" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=none;fontSize=13;fontStyle=1;collapsible=0;container=1;bpmn=pool;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1364" height="740" as="geometry"/></mxCell><mxCell id="CB" value="Cán bộ căng tin" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;fontSize=11;fontStyle=0;collapsible=0;container=1;bpmn=lane;" vertex="1" parent="P"><mxGeometry x="34" y="0" width="1330" height="580" as="geometry"/></mxCell><mxCell id="HT" value="Hệ thống quản lý kho căng tin" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;fontSize=11;fontStyle=0;collapsible=0;container=1;bpmn=lane;" vertex="1" parent="P"><mxGeometry x="34" y="580" width="1330" height="160" as="geometry"/></mxCell><mxCell id="S1" value="Cần cập nhật nhà cung cấp, giá nhập hoặc kho" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;whiteSpace=wrap;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;fontSize=10;labelWidth=110;outline=standard;symbol=general;bpmn=start:none:;" vertex="1" parent="CB"><mxGeometry x="125" y="270" width="40" height="40" as="geometry"/></mxCell><mxCell id="G1" value="Cập nhật gì?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=top;verticalAlign=bottom;align=center;whiteSpace=wrap;perimeter=rhombusPerimeter;outlineConnect=0;fontSize=10;labelWidth=130;outline=none;symbol=none;gwType=exclusive;bpmn=gateway:xor;" vertex="1" parent="CB"><mxGeometry x="330" y="265" width="50" height="50" as="geometry"/></mxCell><mxCell id="QTPR-02.01" value="&lt;b&gt;PROC-02.01&lt;/b&gt; Cập nhật hồ sơ nhà cung cấp&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;thêm, sử