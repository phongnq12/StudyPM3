<mxfile host="ba-bpmn"><diagram name="PROC-05 Kiểm kê tồn kho" id="bpmn"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P" value="PROC-05 Kiểm kê tồn kho" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=none;fontSize=13;fontStyle=1;collapsible=0;container=1;bpmn=pool;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3254" height="1110" as="geometry"/></mxCell><mxCell id="TCS" value="Trưởng cơ sở" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;fontSize=11;fontStyle=0;collapsible=0;container=1;bpmn=lane;" vertex="1" parent="P"><mxGeometry x="34" y="0" width="3220" height="300" as="geometry"/></mxCell><mxCell id="TKK" value="Tổ kiểm kê" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;fontSize=11;fontStyle=0;collapsible=0;container=1;bpmn=lane;" vertex="1" parent="P"><mxGeometry x="34" y="300" width="3220" height="230" as="geometry"/></mxCell><mxCell id="HT" value="Hệ thống quản lý kho căng tin" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;fontSize=11;fontStyle=0;collapsible=0;container=1;bpmn=lane;" vertex="1" parent="P"><mxGeometry x="34" y="530" width="3220" height="580" as="geometry"/></mxCell><mxCell id="POS" value="Hệ thống bán hàng căng tin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;fontSize=11;fontStyle=1;bpmn=blackpool;" vertex="1" parent="1"><mxGeometry x="494.0" y="1170" width="1660" height="50" as="geometry"/></mxCell><mxCell id="S1" value="Đến kỳ kiểm kê hoặc cần kiểm kê đột xuất" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;whiteSpace=wrap;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;fontSize=10;labelWidth=110;outline=standard;symbol=general;bpmn=start:none:;" vertex="1" parent="TCS"><mxGeometry x="125" y="60" width="40" height="40" as="geometry"/></mxCell><mxCell id="PROC-05.01" value="&lt;b&gt;PROC-05.01&lt;/